{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "macrosheet-presentation",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "npm run build" },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "vars": {
    // Optional OPENAI_APPS_CHALLENGE belongs in ignored deployment config.
    // Do not put an actual portal token in this public template.
    "ALLOWED_HOSTS": "127.0.0.1,localhost",
    "WIDGET_DOMAIN": "https://widgets.example.com",
    "USAGE_ANALYTICS_ENABLED": "false"
  },
  "analytics_engine_datasets": [{ "binding": "USAGE_ANALYTICS", "dataset": "macrosheet_usage_test" }],
  "ratelimits": [{
    "name": "MCP_RATE_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 50, "period": 10 }
  }],
  "observability": { "enabled": false }
}
